# Yerel gelistirme. Docker Postgres konteyneri: randevu-test-pg (port 5455).
# Ayni konteynerde iki veritabani: randevu_dev (gelistirme) ve randevu_test (testler).
DATABASE_URL="postgresql://postgres:postgres@localhost:5455/randevu_dev"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5455/randevu_test"

# Bildirim kanallari: sahte = hicbir sey gonderilmez, kuyruga yazilir ve
# /panel/gelistirici/bildirimler ekranindan onizlenir.
BILDIRIM_MODU="sahte"

# Bot korumasi (Faz G2). sahte = kapi hep gecirir; YALNIZCA "gercek" yazilirsa
# jeton dogrulanir. Varsayilan bilerek gevsek: anahtari olmayan bir gelistirici
# ortaminda her randevunun 403 almasi, korumadan cok gelistirmeyi engellerdi.
TURNSTILE_MODU="sahte"

# Site anahtari HALKA ACIK - tarayiciya gitmek uzere tasarlandi. NEXT_PUBLIC_
# onekli oldugu icin DERLEME ANINDA gomuluyor: `npm run cf:kur` adiminda
# ortamda olmasi gerekiyor, yalnizca calisma aninda tanimlanmasi yetmez.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="<turnstile-site-anahtari>"

# GIZLI. Uretimde .env'e degil `wrangler secret put TURNSTILE_SECRET` ile
# giriliyor; buradaki satir yalnizca yerelde gercek modu denemek icin.
TURNSTILE_SECRET="<turnstile-gizli-anahtari>"

# --- Supabase (prod) ---
# Supavisor SESSION MODE (port 5432). Direct baglanti IPv6-only oldugu icin
# kullanilmiyor; 6543 transaction mode ise Prisma'nin prepared statement'larini
# kiriyor.
SUPABASE_PROJE_REF="<proje-ref>"
SUPABASE_DB_URL="postgresql://postgres.<proje-ref>:<sifre>@aws-0-<bolge>.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Supabase Auth ---
# Ikisi de HALKA ACIK degerler: anon anahtari tarayiciya gitmek uzere
# tasarlandi ve tek basina hicbir veriye erisim vermiyor. Kiraci izolasyonu bu
# anahtara degil, sunucudaki scoped-db katmanina dayaniyor.
#
# NEXT_PUBLIC_ onekli degiskenler DERLEME ANINDA gomuluyor: Cloudflare'e
# yayinlarken bunlarin `npm run cf:kur` adiminda ortamda olmasi gerekiyor,
# yalnizca calisma aninda tanimlanmalari yetmez.
NEXT_PUBLIC_SUPABASE_URL="https://<proje-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-anahtari>"

# Kanonik adres. checkOrigin bunu kabul edilen origin listesine ekliyor:
# Cloudflare'de ayni dagitima hem custom domain'den hem *.workers.dev
# onizlemesinden ulasilabiliyor. Tanimsizsa liste kisaliyor, yani varsayilan
# davranis daha dar - yerelde bos birakilabilir.
NEXT_PUBLIC_SITE_URL="https://randevu.enesmemduhoglu.tech"
