# Yerel gelistirme. Docker Postgres konteyneri: randevu-test-pg (port 5455).
# Ayni konteynerde iki veritabani: randevu_dev (gelistirme) ve randevu_test (testler).
DATABASE_URL="postgresql://postgres:postgres@localhost:5455/randevu_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5455/randevu_test?schema=public"

# Bildirim kanallari: sahte = hicbir sey gonderilmez, kuyruga yazilir ve
# /panel/gelistirici/bildirimler ekranindan onizlenir.
BILDIRIM_MODU="sahte"
