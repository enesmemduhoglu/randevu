{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "randevu",
  "main": ".open-next/worker.js",
  // workerd 1.20260828.1 ile hizali; ileri bir tarih verilirse calistirici reddeder.
  "compatibility_date": "2026-08-28",
  // nodejs_compat: Prisma ve pg node: API'lerine ihtiyac duyuyor.
  // global_fetch_strictly_public: OpenNext'in gerektirdigi bayrak.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // TURNSTILE_MODU BURADA OLMAK ZORUNDA.
  //
  // turnstile.ts yalnizca "gercek" yazan degeri gercek sayiyor; tanimsizken
  // `sahte`ye dusuyor ve kapi KOSULSUZ geciriyor. Bu blok yokken uretim tam
  // olarak o durumdaydi: bot kapisi yazilmis, test edilmis, canlida acik
  // duruyordu. Kimse fark etmedi cunku sessizce acik kalan bir kapinin
  // gorunur bir belirtisi yok.
  //
  // Sir DEGIL, yalnizca bir mod anahtari - sir olan TURNSTILE_SECRET ve o
  // `wrangler secret put` ile giriliyor, buraya yazilmiyor (DEGISMEZ 5).
  //
  // Bu satirin silinmesini `src/lib/degismezler.test.ts` yakaliyor: yapilandirma
  // da kod gibi sinaniyor, cunku bu hata tam olarak "kimsenin bakmadigi yerde
  // sessizce kayboldu" bicimindeydi.
  "vars": {
    "TURNSTILE_MODU": "gercek"
  },
  // Workers'in yerel hiz sinirlayicisi. Panel WAF kurali yerine burada olmasinin
  // sebebi: bu dosya PR'da inceleniyor ve `wrangler dev` ile yerelde de kosuyor.
  // Panelde elle acilan bir kural depoda hicbir iz birakmaz ve "acik miydi"
  // sorusunun cevabi yalnizca birinin hafizasinda kalir.
  //
  // Sayac KOLO BASINA ve yaklasik: Cloudflare bunu kuresel olarak toplamiyor.
  // Yani sinir kesin bir muhasebe degil, ucuz bir kalkan - amaci tek makineden
  // gelen betigi yavaslatmak, kuresel bir kotayi zorlamak degil.
  //
  // `period` yalnizca 10 ya da 60 kabul ediyor (wrangler sema kisiti).
  "ratelimits": [
    {
      // Randevu YAZMA. Mesru musteri bir randevu aliyor, hatali denemeyle
      // birlikte birkac istek atiyor; dakikada 5 fazlasiyla yeterli.
      "name": "RANDEVU_SINIRI",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // Musaitlik OKUMA. Gun seridinde gezinen musteri her tikta bir istek
      // atiyor, yani sinir yazmadan cok daha gevsek olmali; buradaki amac
      // takvimi kazimaya calisan betigi durdurmak.
      "name": "MUSAITLIK_SINIRI",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // Wrangler'in kendi esbuild adimi varsayilan olarak keep_names: true
  // kullanir; bu next-themes'in <head>'e gomdugu satir ici betikte sorun
  // cikarir. O betik `M.toString()` ile fonksiyonu ISLENMIS (bundle edilmis)
  // haliyle metne cevirip tarayiciya gonderiyor - keep_names acikken esbuild
  // ic ice tanimli fonksiyonlarin (`function p(n){...}`) hemen ardina
  // `__name(p, "p")` cagrisi ekliyor. Bu cagri worker paketinin ust
  // seviyesinde tanimli yardimciya (`__name`) bakiyor; toString() ile
  // disari cikan metinde o tanim yok, tarayicida "ReferenceError: __name is
  // not defined" ile patliyor. OpenNext'in kendi esbuild adimi (bundle-server.js)
  // keep_names'i hic ayarlamiyor (esbuild varsayilani false) - sorun yalnizca
  // Wrangler'in worker.js'i tekrar paketledigi son adimda ortaya cikiyor.
  "keep_names": false,
  // workers.dev KAPALI, tek adres custom domain.
  //
  // Iki sebep: (1) bu hesapta workers.dev alt alan adi kayitli degil ve
  // wrangler'in otomatik denedigi "randevu" adi kuresel olarak alinmis;
  // (2) plan zaten tek kanonik adres istiyor - iki adresten servis edilen bir
  // uygulama, checkOrigin listesini ve paylasilan baglantilari ikiye boler.
  "workers_dev": false,
  // custom_domain: true -> Cloudflare bu ALT ALAN ADI icin DNS kaydini
  // kendisi olusturuyor ve sertifikayi yonetiyor. Kok alan adina
  // DOKUNMUYOR: orada baska bir proje ve Email Routing'in MX kayitlari
  // duruyor (bkz. docs/plan.md).
  "routes": [
    {
      "pattern": "randevu.enesmemduhoglu.tech",
      "custom_domain": true
    }
  ],
  // Kaynak: Supabase Supavisor SESSION MODE (port 5432). Direct baglanti
  // (db.<ref>.supabase.co) yalnizca IPv6 cozdugu icin kullanilamiyor; 6543
  // transaction mode ise Prisma'nin named prepared statement'larini kiriyor.
  // Sorgu onbellegi KAPALI: musaitlik sorgusu yazma kararini besliyor, bayat
  // veri dolu bir slotu bos gosterirdi.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4b107f2d175a45e9b7a783d678be55c5",
      // Yerelde binding'i taklit eden Postgres. Gizli bir sey degil: yalnizca
      // gelistirme konteynerine bakiyor. Bu deger olmadan `next build` ve
      // `wrangler dev` binding'i cozemeyip patliyor.
      "localConnectionString": "postgresql://postgres:postgres@localhost:5455/randevu_dev"
    }
  ]
}
