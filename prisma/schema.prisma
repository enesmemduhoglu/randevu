// Sema kaynagi. Alan ve model adlari Turkce - depo sozlesmesi (bkz. CLAUDE.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Kiraci koku. Kiraciya bagli her model isletmeId tasir ve sorgular
/// yalnizca src/lib/scoped-db.ts uzerinden, o filtre enjekte edilerek gider.
model Isletme {
  id   String @id @default(uuid(7))
  slug String @unique
  ad   String

  // Randevu zamanlari DB'de UTC durur; yerel saate cevirme bu alanla yapilir.
  saatDilimi String @default("Europe/Istanbul")

  aktif            Boolean  @default(true)
  olusturmaTarihi  DateTime @default(now())
  guncellemeTarihi DateTime @updatedAt

  @@index([aktif])
}
